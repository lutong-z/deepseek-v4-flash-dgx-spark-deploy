# Copy outside this repository and fill with site-owned values.
# The renderer accepts this file only as KEY=VALUE records; it never sources it.

HEAD_HOST=
WORKER_HOST=
SSH_USER=
HEAD_SSH_USER=
WORKER_SSH_USER=
SSH_PORT=22
SSH_KNOWN_HOSTS_FILE=
SSH_IDENTITY_FILE=

REMOTE_ROOT=/srv/dgx-spark/deploy
MODEL_ROOT=/srv/models
MODEL_MANIFEST_SHA256=
STATE_ROOT=/var/lib/dgx-spark/state
CACHE_ROOT=/var/cache/dgx-spark
LOG_ROOT=/var/log/dgx-spark
RESULT_ROOT=/var/lib/dgx-spark/results

REGISTRY=
IMAGE_REF=
MASTER_ADDR=
MASTER_PORT=29519
API_PORT=8000
HEAD_NODE_ADDR=
WORKER_NODE_ADDR=
HEAD_NET_IFACE=
WORKER_NET_IFACE=
HEAD_HCA=
WORKER_HCA=
HEAD_CUDA_VISIBLE_DEVICES=
WORKER_CUDA_VISIBLE_DEVICES=
ROCE_GID_INDEX=
ROCE_MTU=9000
API_BIND_ADDR=127.0.0.1
FORWARD_LOCAL_PORT=18080

# Optional build/transfer and acceptance values. Keep credentials out of this file.
BASE_IMAGE_REF=
BUILD_CONTEXT=
CONTAINERFILE=container/Containerfile
IMAGE_REPOSITORY=
IMAGE_TAG=
IMAGE_ARCHIVE=
IMAGE_ARCHIVE_SHA256=
REMOTE_IMAGE_ARCHIVE=
PERF_MIN_TOKENS_PER_SECOND=
PERF_MAX_TTFT_SECONDS=
PERF_MAX_P95_ITL_MS=
