# Copy outside this repository and fill with site-owned values.
# The renderer accepts this file only as KEY=VALUE records; it never sources it.

DEPLOYMENT_MODE=production
IMAGE_LOCK_FILE=
HEAD_IMAGE_REF=
WORKER_IMAGE_REF=
FABRIC_PROFILE=f1
HEAD_FABRIC_CIDR=192.168.100.10/24
WORKER_FABRIC_CIDR=192.168.100.11/24
HEAD_FABRIC_PEER=192.168.100.11
WORKER_FABRIC_PEER=192.168.100.10
HEAD_FABRIC_CONNECTION=f1-head
WORKER_FABRIC_CONNECTION=f1-worker
# Leave role GID indexes empty for discovery, then record read-back values.
HEAD_ROCE_GID_INDEX=
WORKER_ROCE_GID_INDEX=

HEAD_HOST=192.168.100.10
WORKER_HOST=192.168.100.11
HEAD_SSH_HOST=DGX-SPARK-0
WORKER_SSH_HOST=DGX-SPARK-1
SSH_USER=
HEAD_SSH_USER=
WORKER_SSH_USER=
SSH_PORT=22
SSH_KNOWN_HOSTS_FILE=
SSH_IDENTITY_FILE=

MODEL_ROOT=/srv/models/DeepSeek-V4-Flash-0731
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-0731
MODEL_MANIFEST_SHA256=
STATE_ROOT=/var/lib/dgx-spark/state
CACHE_ROOT=/var/cache/dgx-spark
LOG_ROOT=/var/log/dgx-spark
RESULT_ROOT=/var/lib/dgx-spark/results

REGISTRY=
IMAGE_REF=
MASTER_ADDR=192.168.100.10
MASTER_PORT=29619
API_PORT=8101
HEAD_NODE_ADDR=192.168.100.10
WORKER_NODE_ADDR=192.168.100.11
HEAD_NET_IFACE=enp1s0f1np1
WORKER_NET_IFACE=enp1s0f1np1
HEAD_HCA=rocep1s0f1
WORKER_HCA=rocep1s0f1
HEAD_CUDA_VISIBLE_DEVICES=
WORKER_CUDA_VISIBLE_DEVICES=
ROCE_GID_INDEX=
ROCE_MTU=9000
API_BIND_ADDR=127.0.0.1
ALLOW_PUBLIC_API=0
FORWARD_LOCAL_PORT=18080

# Optional build/transfer and acceptance values. Keep credentials out of this file.
